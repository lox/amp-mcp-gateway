#!/usr/bin/env bash
set -euo pipefail

image="registry.fly.io/lox-mcp-gateway:$BUILDKITE_COMMIT"
# Fly Machines run amd64; a plain manifest avoids attestation indexes.
build=(docker buildx build --platform linux/amd64 --provenance=false --tag "$image")

# Pull requests only verify the image, so they never receive the Fly credential.
if [[ "${BUILDKITE_BRANCH:-}" != main || "${BUILDKITE_PULL_REQUEST:-false}" != false ]]; then
  "${build[@]}" .
  exit 0
fi

# Buildkite's Docker builder keeps BuildKit layers and cache mounts warm. Push
# before checks finish; the deploy job still gates production changes.
set +x
FLY_API_TOKEN=$(buildkite-agent secret get MCP_GATEWAY_FLY_DEPLOY)
export FLY_API_TOKEN
flyctl auth docker
"${build[@]}" --push .
