#!/usr/bin/env bash
set -euo pipefail

if [[ "${BUILDKITE_BRANCH:-}" != main || "${BUILDKITE_PULL_REQUEST:-false}" != false ]]; then
  echo 'Only non-PR main builds can deploy.' >&2
  exit 1
fi

# Checked while holding the Buildkite concurrency slot: do not roll back a newer head.
head=$(git rev-parse HEAD)
latest=$(git ls-remote origin refs/heads/main | cut -f1)
if [[ -z "$latest" ]]; then
  echo 'Cannot determine current main head.' >&2
  exit 1
fi
if [[ "$head" != "$latest" ]]; then
  echo 'Skipping superseded main build.'
  exit 0
fi

# Fetch only in the deploy job, never upload the credential or print it.
set +x
FLY_API_TOKEN=$(buildkite-agent secret get MCP_GATEWAY_FLY_DEPLOY)
export FLY_API_TOKEN
flyctl config validate
flyctl deploy --app lox-mcp-gateway --remote-only --ha=false --yes
curl --fail --silent --show-error --retry 5 --retry-delay 2 --max-time 20 \
  https://lox-mcp-gateway.fly.dev/healthz
